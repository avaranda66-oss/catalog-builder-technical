  101:   async list(query: CatalogLibraryQuery = {}): Promise<CatalogLibraryResult<readonly CatalogListItem[]>> {
  102:     const view = query.view ?? 'active';
  103:     const result = await this.options.repository.listCatalogs({ includeArchived: view === 'archived' });
  104:     if (!result.ok) return failure(result.error.code, result.error.message);
  105:     return { ok: true, value: projectCatalogLibraryItems(result.value, query) };
  106:   }
  107: 
  108:   async createBlank(title = 'Novo catálogo'): Promise<CatalogLibraryResult<CatalogPersistenceEnvelope>> {
  109:     let documentSnapshot;
  110:     try {
  111:       documentSnapshot = createCatalogDocument(this.options.createId, title.trim() || 'Novo catálogo');
  112:     } catch (error) {
  113:       return failure('INVALID_DOCUMENT', error instanceof Error ? error.message : String(error));
  114:     }
  115:     const result = await this.options.repository.createCatalog({
  116:       mutationId: this.options.createMutationId(),
  117:       documentSnapshot,
  118:     });
  119:     if (!result.ok) return failure(result.error.code, result.error.message);
  120:     try {
  121:       const envelope = parsePersistenceEnvelope(result.value);
  122:       if (envelope.catalogId !== documentSnapshot.id || envelope.documentSnapshot.id !== documentSnapshot.id) {
  123:         return failure('ENVELOPE_MISMATCH', 'Create acknowledgement does not match the created catalog identity');
  124:       }
  125:       return { ok: true, value: envelope };
  126:     } catch (error) {
  127:       return failure('INVALID_DOCUMENT', error instanceof Error ? error.message : String(error));
  128:     }
  129:   }
  130: 
  131:   async rename(catalogId: string, rawTitle: string): Promise<CatalogLibraryResult<CatalogListItem>> {
  132:     const title = rawTitle.trim();
  133:     if (!title) return failure('INVALID_TITLE', 'O nome do catálogo não pode ficar vazio.');
  134: 
  135:     const read = await this.options.repository.getCatalog(catalogId);
  136:     if (!read.ok) return failure(read.error.code, read.error.message);
  137: 
  138:     let envelope: CatalogPersistenceEnvelope;
  139:     try {
  140:       envelope = parsePersistenceEnvelope(read.value);
  141:     } catch (error) {
  142:       return failure('INVALID_DOCUMENT', error instanceof Error ? error.message : String(error));
  143:     }
  144:     if (envelope.catalogId !== catalogId || envelope.documentSnapshot.id !== catalogId) {
  145:       return failure('ENVELOPE_MISMATCH', 'Requested catalog identity does not match the authoritative document');
  146:     }
  147: 
  148:     const session = createDocumentSession(envelope.documentSnapshot, this.options.applicationDependencies);
  149:     const action = session.execute({ type: 'document.rename', title });
  150:     if (!action.ok) return failure('ACTION_REJECTED', action.error.details);
  151:     if (!action.metadata.changed) return { ok: true, value: listItemFromMetadata(metadataFromEnvelope(envelope)) };
  152: 
  153:     const runtime = new VNextPersistenceRuntime({
  154:       session,
  155:       repository: this.options.repository,
  156:       applicationDependencies: this.options.applicationDependencies,
  157:       createMutationId: this.options.createMutationId,
  158:       createOpenSessionId: this.options.createOpenSessionId,
  159:       authLineage: this.options.authLineage(),
  160:       authorityScopeId: this.options.authorityScopeId(),
  161:       binding: envelope,
  162:     });
  163:     const saved = await runtime.saveCoordinator.save();
  164:     if (!saved.ok) return failure(saved.error.code, saved.error.message);
  165: 
  166:     const refreshed = await this.options.repository.getCatalog(catalogId);
  167:     if (!refreshed.ok) return failure(refreshed.error.code, refreshed.error.message);
  168:     try {
  169:       const authoritative = parsePersistenceEnvelope(refreshed.value);
  170:       return { ok: true, value: listItemFromMetadata(metadataFromEnvelope(authoritative)) };
  171:     } catch (error) {
  172:       return failure('INVALID_DOCUMENT', error instanceof Error ? error.message : String(error));
  173:     }
  174:   }
  175: 
  176:   async archive(catalogId: string): Promise<CatalogLibraryResult<CatalogPersistenceMetadata>> {
  177:     const read = await this.options.repository.getCatalog(catalogId);
  178:     if (!read.ok) return failure(read.error.code, read.error.message);
  179:     let envelope: CatalogPersistenceEnvelope;
  180:     try {
  181:       envelope = parsePersistenceEnvelope(read.value);
  182:     } catch (error) {
  183:       return failure('INVALID_DOCUMENT', error instanceof Error ? error.message : String(error));
  184:     }
  185:     if (envelope.catalogId !== catalogId || envelope.documentSnapshot.id !== catalogId) {
  186:       return failure('ENVELOPE_MISMATCH', 'Requested catalog identity does not match the authoritative document');
  187:     }
  188:     const archived = await this.options.repository.archiveCAS({
  189:       mutationId: this.options.createMutationId(),
  190:       catalogId,
  191:       expectedRemoteRevision: envelope.remoteRevision,
  192:     });
  193:     if (!archived.ok) return failure(archived.error.code, archived.error.message);
  194:     return { ok: true, value: archived.value };
  195:   }
  196: }
