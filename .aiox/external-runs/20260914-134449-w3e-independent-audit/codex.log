   70: 
   71: type OperationKind = 'read' | 'mutation';
   72: 
   73: function failure<T>(code: PersistenceErrorCode, message?: string): PersistenceResult<T> {
   74:   const error: PersistenceError = message ? { code, message } : { code };
   75:   return { ok: false, error };
   76: }
   77: 
   78: function canonicalUuidOrFailure(value: string, label: string): PersistenceResult<string> {
   79:   return CANONICAL_UUID_PATTERN.test(value)
   80:     ? { ok: true, value }
   81:     : failure('INVALID_DOCUMENT', `${label} must be an exact canonical lowercase UUID`);
   82: }
   83: 
   84: function contractFailure<T>(error: unknown): PersistenceResult<T> {
   85:   if (error instanceof PersistenceContractError) return failure(error.code, error.message);
   86:   return failure('INVALID_DOCUMENT', error instanceof Error ? error.message : String(error));
   87: }
   88: 
   89: function rpcMessage(error: VNextPersistenceRpcError): string {
   90:   return [error.message, error.details, error.hint].filter((part): part is string => Boolean(part)).join(' | ');
   91: }
   92: 
   93: const TRANSPORT_ERROR_CODES = new Set([
   94:   'ETIMEDOUT',
   95:   'ECONNRESET',
   96:   'ECONNREFUSED',
   97:   'ECONNABORTED',
   98:   'EHOSTUNREACH',
   99:   'ENETUNREACH',
  100:   'ENETDOWN',
  101:   'ENOTFOUND',
  102:   'EAI_AGAIN',
  103:   'UND_ERR_CONNECT_TIMEOUT',
  104:   'ABORT_ERR',
  105: ]);
  106: 
  107: function isTransportLike(error: VNextPersistenceRpcError): boolean {
  108:   const code = error.code?.toUpperCase();
  109:   if (code && TRANSPORT_ERROR_CODES.has(code)) return true;
  110:   const message = rpcMessage(error).toLowerCase();
  111:   return /failed to fetch|network|timeout|timed out|connection|econn|abort/.test(message);
  112: }
  113: 
  114: function mapSemanticRpcError(error: VNextPersistenceRpcError): PersistenceErrorCode | null {
  115:   const message = rpcMessage(error);
  116:   if (message.includes('VNEXT_NOT_FOUND')) return 'NOT_FOUND';
  117:   if (message.includes('VNEXT_ARCHIVED')) return 'ARCHIVED';
  118:   if (message.includes('VNEXT_UNSUPPORTED_VERSION')) return 'UNSUPPORTED_VERSION';
  119:   if (
  120:     message.includes('VNEXT_CONFLICT') ||
  121:     message.includes('VNEXT_DUPLICATE_CATALOG') ||
  122:     message.includes('VNEXT_MUTATION_REUSE') ||
  123:     message.includes('VNEXT_MUTATION_REPLAY_STALE')
  124:   ) return 'CONFLICT';
  125:   if (error.code === '42501' || message.includes('VNEXT_UNAUTHORIZED') || message.includes('AUTH_')) return 'UNAUTHORIZED';
  126:   if (error.code === '40001' || error.code === '23505') return 'CONFLICT';
  127:   if (error.code === '22023' || error.code === '22P02' || message.includes('VNEXT_INVALID_DOCUMENT')) return 'INVALID_DOCUMENT';
  128:   return null;
  129: }
