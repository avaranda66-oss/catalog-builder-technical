  100:               ownerAuthorityScopeId: activeBinding.authorityScopeId,
  101:               activeAuthorityScopeId: snapshot.activeAuthorityScopeId,
  102:               catalogId: snapshot.session.getSnapshot().document.id,
  103:               openSessionId: activeBinding.openSessionId,
  104:               localEditSequence: snapshot.session.getSnapshot().localSequence,
  105:               documentSnapshot: snapshot.session.getSnapshot().document,
  106:               baseRemoteRevision: activeBinding.kind === 'PERSISTED' ? activeBinding.remoteRevision : 0,
  107:               baseRemoteSnapshot: activeBinding.kind === 'PERSISTED'
  108:                 ? activeBinding.acknowledgedSnapshot
  109:                 : activeBinding.initialSnapshot,
  110:               dirty: snapshot.dirty,
  111:               ...(authoringRecoveryOverlay
  112:                 ? { authoringRecoveryOverlay }
