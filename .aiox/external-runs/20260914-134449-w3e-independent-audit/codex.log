   51: export interface VNextPersistenceRpcError {
   52:   readonly code?: string | null;
   53:   readonly message?: string | null;
   54:   readonly details?: string | null;
   55:   readonly hint?: string | null;
   56: }
   57: 
   58: export interface VNextPersistenceRpcResponse<T = unknown> {
   59:   readonly data: T | null;
   60:   readonly error: VNextPersistenceRpcError | null;
   61: }
   62: 
   63: export interface VNextPersistenceRpcClient {
   64:   rpc(functionName: string, args?: Record<string, unknown>): Promise<VNextPersistenceRpcResponse>;
   65: }
   66: 
   67: export interface SupabaseCatalogRepositoryOptions {
   68:   readonly isOffline?: () => boolean;
