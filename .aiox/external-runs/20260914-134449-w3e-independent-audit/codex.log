  394:     let replay: PersistenceResult<CatalogPersistenceEnvelope>;
  395:     try {
  396:       replay = await this.options.repository.saveCAS(attempt.request);
  397:     } catch (error) {
  398:       this.ambiguousAttempt = attempt;
  399:       const message = error instanceof Error ? error.message : String(error);
  400:       this.options.workspace.setPhase('ambiguous', message);
