   51:   readonly createCatalog = vi.fn(async (request: CreateCatalogRequest): Promise<PersistenceResult<CatalogPersistenceEnvelope>> => {
   52:     if (this.catalogs.has(request.documentSnapshot.id)) return { ok: false, error: { code: 'CONFLICT' } };
   53:     const timestamp = this.timestamp();
   54:     const envelope: CatalogPersistenceEnvelope = {
   55:       catalogId: request.documentSnapshot.id,
   56:       remoteRevision: 1,
   57:       lastMutationId: request.mutationId,
   58:       title: request.documentSnapshot.title,
   59:       locale: request.documentSnapshot.locale,
   60:       createdAt: timestamp,
   61:       updatedAt: timestamp,
   62:       createdBy: 'user-a',
   63:       updatedBy: 'user-a',
   64:       archivedAt: null,
   65:       documentSchemaVersion: 1,
   66:       documentSnapshot: request.documentSnapshot,
   67:     };
   68:     this.catalogs.set(envelope.catalogId, envelope);
   69:     return { ok: true, value: envelope };
   70:   });
   71: 
   72:   readonly saveCAS = vi.fn(async (request: SaveCatalogCasRequest): Promise<PersistenceResult<CatalogPersistenceEnvelope>> => {
   73:     this.beforeNextSave?.();
   74:     this.beforeNextSave = undefined;
   75:     const current = this.catalogs.get(request.catalogId);
   76:     if (!current) return { ok: false, error: { code: 'NOT_FOUND' } };
   77:     if (current.archivedAt) return { ok: false, error: { code: 'ARCHIVED' } };
   78:     if (current.remoteRevision !== request.expectedRemoteRevision) return { ok: false, error: { code: 'CONFLICT' } };
   79:     const envelope: CatalogPersistenceEnvelope = {
   80:       ...current,
   81:       remoteRevision: current.remoteRevision + 1,
   82:       lastMutationId: request.mutationId,
   83:       title: request.documentSnapshot.title,
   84:       locale: request.documentSnapshot.locale,
   85:       updatedAt: this.timestamp(),
   86:       documentSnapshot: request.documentSnapshot,
   87:     };
   88:     this.catalogs.set(request.catalogId, envelope);
   89:     return { ok: true, value: envelope };
   90:   });
   91: 
   92:   readonly archiveCAS = vi.fn(async (request: ArchiveCatalogCasRequest): Promise<PersistenceResult<CatalogPersistenceMetadata>> => {
   93:     this.beforeNextArchive?.();
   94:     this.beforeNextArchive = undefined;
   95:     const current = this.catalogs.get(request.catalogId);
   96:     if (!current) return { ok: false, error: { code: 'NOT_FOUND' } };
   97:     if (current.archivedAt) return { ok: false, error: { code: 'ARCHIVED' } };
   98:     if (current.remoteRevision !== request.expectedRemoteRevision) return { ok: false, error: { code: 'CONFLICT' } };
   99:     const envelope: CatalogPersistenceEnvelope = {
  100:       ...current,
  101:       remoteRevision: current.remoteRevision + 1,
  102:       lastMutationId: request.mutationId,
  103:       archivedAt: this.timestamp(),
  104:       updatedAt: this.timestamp(),
  105:     };
  106:     this.catalogs.set(request.catalogId, envelope);
  107:     const { documentSnapshot: _snapshot, ...metadata } = envelope;
  108:     return { ok: true, value: metadata };
  109:   });
  110: 
  111:   seed(envelope: CatalogPersistenceEnvelope): void {
  112:     this.catalogs.set(envelope.catalogId, envelope);
  113:   }
  114: 
  115:   advance(catalogId: string): void {
  116:     const current = this.catalogs.get(catalogId);
  117:     if (!current) return;
  118:     this.catalogs.set(catalogId, {
  119:       ...current,
  120:       remoteRevision: current.remoteRevision + 1,
  121:       lastMutationId: uuid(9000 + current.remoteRevision),
  122:       updatedAt: this.timestamp(),
  123:     });
  124:   }
  125: 
  126:   current(catalogId: string): CatalogPersistenceEnvelope {
  127:     const value = this.catalogs.get(catalogId);
  128:     if (!value) throw new Error('missing catalog');
  129:     return value;
  130:   }
  131: 
  132:   private timestamp(): string {
  133:     this.tick += 1;
  134:     return new Date(Date.UTC(2026, 8, 14, 12, 0, this.tick)).toISOString();
  135:   }
  136: }
