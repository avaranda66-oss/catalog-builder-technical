   21: function RuntimeWorkspace({ runtime, onRequestLibrary }: { runtime: VNextPersistenceRuntime; onRequestLibrary?: () => void }) {
   22:   const snapshot = React.useSyncExternalStore(
   23:     runtime.workspace.subscribe,
   24:     runtime.workspace.getSnapshot,
   25:     runtime.workspace.getSnapshot
   26:   );
   27:   const [recoveryGate, setRecoveryGate] = React.useState<{
   28:     readonly authorityScopeId: string;
   29:     readonly phase: RecoveryGatePhase;
   30:   }>(() => ({
   31:     authorityScopeId: snapshot.activeAuthorityScopeId,
   32:     phase: runtime.recoveryStartup ? 'PENDING' : 'RELEASED',
   33:   }));
   34:   const activeRecoveryGatePhase = recoveryGate.authorityScopeId === snapshot.activeAuthorityScopeId
   35:     ? recoveryGate.phase
   36:     : 'PENDING';
   37:   const updateRecoveryGate = React.useCallback((phase: RecoveryGatePhase) => {
   38:     setRecoveryGate({ authorityScopeId: snapshot.activeAuthorityScopeId, phase });
   39:   }, [snapshot.activeAuthorityScopeId]);
   40:   const recoveredOverlay = runtime.getRecoveredOverlay(snapshot.binding.openSessionId);
   41:   return (
   42:     <>
   43:       {activeRecoveryGatePhase === 'RELEASED' && (
   44:         <EditorWorkspace
   45:           key={snapshot.binding.openSessionId}
   46:           session={snapshot.session}
   47:           onRequestLibrary={onRequestLibrary}
   48:           persistence={{
   49:             runtime,
   50:             openSessionId: snapshot.binding.openSessionId,
   51:             save: snapshot.save,
   52:             assetUrls: snapshot.assetUrls,
   53:             localProtection: snapshot.localProtection,
   54:             ...(snapshot.localProtectionMessage
   55:               ? { localProtectionMessage: snapshot.localProtectionMessage }
   56:               : {}),
   57:             ...(recoveredOverlay
   58:               ? { recoveredOverlay }
   59:               : {}),
   60:           }}
   61:         />
   62:       )}
   63:       {runtime.recoveryStartup && (
   64:         <RecoveryCenter
   65:           key={snapshot.activeAuthorityScopeId}
   66:           runtime={runtime}
   67:           authorityScopeId={snapshot.activeAuthorityScopeId}
   68:           onGatePhaseChange={updateRecoveryGate}
   69:         />
   70:       )}
   71:     </>
   72:   );
   73: }
   74: 
   75: function InMemoryWorkspace({ suppliedSession }: { suppliedSession?: DocumentSession }) {
   76:   const sessionRef = React.useRef<DocumentSession | null>(null);
   77:   if (!suppliedSession && !sessionRef.current) {
   78:     sessionRef.current = createDocumentSession(createW2CDemoDocument(createBrowserId), { createId: createBrowserId, templateRegistry: createStaticPageTemplateRegistry([W2E_PAGE_TEMPLATE]) });
   79:   }
   80:   const session = suppliedSession ?? sessionRef.current;
   81:   if (!session) throw new Error('VNext document session unavailable');
   82:   return <EditorWorkspace session={session} />;
   83: }
   84: 
   85: export function VNextApp({ session: suppliedSession, runtime, onRequestLibrary }: VNextAppProps = {}) {
   86:   return runtime
   87:     ? <RuntimeWorkspace runtime={runtime} onRequestLibrary={onRequestLibrary} />
   88:     : <InMemoryWorkspace suppliedSession={suppliedSession} />;
   89: }
