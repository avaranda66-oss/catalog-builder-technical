   55:   return session?.user.id ?? ANONYMOUS_AUTH_IDENTITY;
   56: }
   57: 
   58: function authorityScopeId(identity: string): string {
   59:   const deployment = import.meta.env.VITE_SUPABASE_URL || window.location.origin;
   60:   return JSON.stringify(['catalog-builder-vnext', deployment, window.location.origin, identity]);
   61: }
   62: 
   63: function activeV2Url(runtime: VNextPersistenceRuntime): string {
   64:   const binding = runtime.workspace.getSnapshot().binding;
   65:   return binding.kind === 'PERSISTED'
   66:     ? `/v2?catalog=${encodeURIComponent(binding.catalogId)}`
   67:     : '/v2';
   68: }
   69: 
   70: function openFailureCode(code: string): CatalogLibraryFailureCode {
   71:   if (code === 'REQUESTED_ID_MISMATCH') return 'ENVELOPE_MISMATCH';
   72:   if (code === 'UNSAVED_CHANGES') return 'STALE_RESULT';
   73:   return code as CatalogLibraryFailureCode;
   74: }
   75: 
   76: export async function mountVNextApp(root: HTMLElement): Promise<void> {
   77:   const applicationDependencies: ApplicationExecutionDependencies = {
   78:     createId: createBrowserId,
   79:     templateRegistry: createStaticPageTemplateRegistry([W2E_PAGE_TEMPLATE]),
   80:   };
   81:   const supabase = getVNextSupabaseClient();
   82:   const repository: CatalogRepository = supabase
   83:     ? new SupabaseCatalogRepository(vnextRpcClientFromSupabase(supabase))
   84:     : unavailableRepository();
   85: 
   86:   const authSession = supabase ? (await supabase.auth.getSession()).data.session : null;
   87:   let authLineage = createAuthLineageState(authIdentity(authSession));
   88:   const lineage = () => authLineageValue(authLineage);
   89:   const identity = () => authLineage.identity;
   90:   const requestedCatalogId = new URLSearchParams(window.location.search).get('catalog');
   91: 
   92:   if (!requestedCatalogId) {
   93:     const library = new CatalogLibraryService({
   94:       repository,
   95:       applicationDependencies,
   96:       createId: createBrowserId,
   97:       createMutationId: createBrowserId,
   98:       createOpenSessionId: createBrowserId,
   99:       authLineage: lineage,
  100:       authorityScopeId: () => authorityScopeId(identity()),
  101:     });
  102:     if (supabase) {
  103:       supabase.auth.onAuthStateChange((_event: AuthChangeEvent, nextSession: Session | null) => {
  104:         authLineage = advanceAuthLineage(authLineage, authIdentity(nextSession));
  105:       });
  106:     }
  107:     ReactDOM.createRoot(root).render(
  108:       <React.StrictMode>
  109:         <CatalogLibrary
  110:           service={library}
  111:           onOpen={(catalogId) => window.location.assign(`/v2?catalog=${encodeURIComponent(catalogId)}`)}
  112:         />
  113:       </React.StrictMode>
  114:     );
  115:     return;
  116:   }
  117: 
  118:   const initialSession = createDocumentSession(
  119:     createW2CDemoDocument(createBrowserId),
  120:     applicationDependencies
  121:   );
  122:   const recoveryRepository = new IndexedDbRecoveryRepository();
  123: 
  124:   const runtime = new VNextPersistenceRuntime({
  125:     session: initialSession,
  126:     repository,
  127:     applicationDependencies,
  128:     createMutationId: createBrowserId,
  129:     createOpenSessionId: createBrowserId,
  130:     authLineage: lineage(),
  131:     authorityScopeId: authorityScopeId(identity()),
  132:     recoveryRepository,
  133:     assetUrls: resolveKnownW2CDemoAssetUrls(initialSession.getSnapshot().document),
  134:     resolveAssetUrls: resolveKnownW2CDemoAssetUrls,
  135:   });
  136: 
  137:   const opened = await runtime.reopenCoordinator.open(
  138:     requestedCatalogId,
  139:     { allowDiscardUnsaved: true }
  140:   );
  141:   if (!opened.ok) {
  142:     ReactDOM.createRoot(root).render(
  143:       <React.StrictMode>
  144:         <CatalogOpenFailure
  145:           code={openFailureCode(opened.error.code)}
  146:           onBack={() => window.location.assign('/v2')}
  147:         />
  148:       </React.StrictMode>
  149:     );
  150:     return;
  151:   }
  152: 
  153:   if (supabase) {
  154:     supabase.auth.onAuthStateChange((_event: AuthChangeEvent, nextSession: Session | null) => {
  155:       const nextIdentity = authIdentity(nextSession);
  156:       authLineage = advanceAuthLineage(authLineage, nextIdentity);
  157:       runtime.updateAuthContext(lineage(), authorityScopeId(nextIdentity));
  158:     });
  159:   }
  160: 
  161:   void navigator.storage?.persist?.().catch(() => false);
  162: 
  163:   window.addEventListener('beforeunload', (event) => {
  164:     const snapshot = runtime.workspace.getSnapshot();
  165:     if (!snapshot.dirty && !runtime.saveCoordinator.hasUnresolvedActiveMutation()) return;
  166:     event.preventDefault();
  167:     event.returnValue = '';
  168:   });
  169: 
  170:   window.addEventListener('popstate', () => {
  171:     const targetCatalogId = new URLSearchParams(window.location.search).get('catalog');
  172:     const snapshot = runtime.workspace.getSnapshot();
  173:     const active = snapshot.binding;
  174:     if (active.kind === 'PERSISTED' && targetCatalogId === active.catalogId) return;
  175:     if (snapshot.dirty || runtime.saveCoordinator.hasUnresolvedActiveMutation()) {
  176:       window.history.replaceState(null, '', activeV2Url(runtime));
  177:       runtime.workspace.setPhase('blocked', 'Salve suas alterações antes de sair deste catálogo.');
  178:       return;
  179:     }
  180:     window.location.reload();
  181:   });
  182: 
  183:   const requestLibrary = () => {
  184:     const snapshot = runtime.workspace.getSnapshot();
  185:     if (snapshot.dirty || runtime.saveCoordinator.hasUnresolvedActiveMutation()) {
  186:       runtime.workspace.setPhase('blocked', 'Salve suas alterações antes de voltar aos catálogos.');
  187:       return;
  188:     }
  189:     window.location.assign('/v2');
  190:   };
  191: 
  192:   ReactDOM.createRoot(root).render(
  193:     <React.StrictMode>
  194:       <VNextApp runtime={runtime} onRequestLibrary={requestLibrary} />
  195:     </React.StrictMode>
  196:   );
  197: }
