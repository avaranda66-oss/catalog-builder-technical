   39: function failureMessage(code: CatalogLibraryFailureCode, action: 'load' | 'create' | 'rename' | 'archive'): string {
   40:   if (code === 'NOT_FOUND') return 'Este catálogo não foi encontrado. Atualize a lista e tente novamente.';
   41:   if (code === 'UNAUTHORIZED') return 'Você não tem acesso a este catálogo. Entre novamente ou peça acesso à equipe.';
   42:   if (code === 'OFFLINE') return 'Você está sem conexão. Conecte-se à internet e tente novamente.';
   43:   if (code === 'REMOTE_FAILURE') return 'Não foi possível acessar a biblioteca agora. Tente novamente.';
   44:   if (code === 'CONFLICT' || code === 'STALE_RESULT') {
   45:     return action === 'rename'
   46:       ? 'O catálogo mudou em outro lugar antes da renomeação. A versão atual foi preservada.'
   47:       : 'O catálogo mudou em outro lugar antes desta ação. A versão atual foi preservada.';
   48:   }
   49:   if (code === 'ARCHIVED') return 'Este catálogo já está arquivado e não pode ser alterado como catálogo ativo.';
   50:   if (code === 'INVALID_DOCUMENT' || code === 'UNSUPPORTED_VERSION' || code === 'ENVELOPE_MISMATCH') {
   51:     return 'Este catálogo contém dados que não puderam ser validados com segurança.';
   52:   }
   53:   if (code === 'AMBIGUOUS_COMMIT_OUTCOME') return 'Não foi possível confirmar o resultado no servidor. Atualize a biblioteca antes de repetir a ação.';
   54:   if (code === 'INVALID_TITLE') return 'Digite um nome para o catálogo.';
   55:   if (action === 'create') return 'Não foi possível criar o novo catálogo.';
   56:   if (action === 'rename') return 'Não foi possível renomear este catálogo.';
