  413:         ok: false,
  414:         error: { code: 'AMBIGUOUS_COMMIT_OUTCOME', message: replay.error.message },
  415:       };
  416:     }
  417:     this.ambiguousAttempt = undefined;
  418:     return this.handleKnownFailure(attempt, replay.error.code, replay.error.message);
  419:   }
