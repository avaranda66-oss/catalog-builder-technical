  507: CREATE FUNCTION public.save_vnext_catalog_cas_v1(
  508:   p_catalog_id TEXT,
  509:   p_expected_remote_revision BIGINT,
  510:   p_mutation_id TEXT,
  511:   p_document_snapshot JSONB
  512: )
  513: RETURNS JSONB
  514: LANGUAGE plpgsql
  515: SECURITY DEFINER
  516: SET search_path = pg_catalog, public
  517: AS $$
  518: DECLARE
  519:   v_actor UUID := public.require_document_editor_v1();
  520:   v_catalog_id UUID;
  521:   v_mutation_id UUID;
  522:   v_current public.vnext_catalogs;
  523:   v_replay public.vnext_catalog_revisions;
  524:   v_new_revision BIGINT;
  525: BEGIN
  526:   v_catalog_id := public.vnext_require_canonical_uuid_text_v1(p_catalog_id, 'catalogId');
  527:   v_mutation_id := public.vnext_require_canonical_uuid_text_v1(p_mutation_id, 'mutationId');
  528:   IF p_expected_remote_revision IS NULL OR p_expected_remote_revision < 1 THEN
  529:     RAISE EXCEPTION 'VNEXT_INVALID_DOCUMENT: expectedRemoteRevision must be positive'
  530:       USING ERRCODE = '22023';
  531:   END IF;
  532: 
  533:   SELECT * INTO v_current
  534:   FROM public.vnext_catalogs
  535:   WHERE id = v_catalog_id
  536:   FOR UPDATE;
  537: 
  538:   IF NOT FOUND THEN
  539:     RAISE EXCEPTION 'VNEXT_NOT_FOUND: catalog % does not exist', p_catalog_id
  540:       USING ERRCODE = 'P0002';
  541:   END IF;
  542:   IF v_current.archived_at IS NOT NULL THEN
  543:     RAISE EXCEPTION 'VNEXT_ARCHIVED: catalog % is archived', p_catalog_id
  544:       USING ERRCODE = 'P0001';
  545:   END IF;
  546: 
  547:   SELECT * INTO v_replay
  548:   FROM public.vnext_catalog_revisions
  549:   WHERE catalog_id = v_catalog_id AND mutation_id = v_mutation_id;
  550: 
  551:   IF FOUND THEN
  552:     IF v_replay.revision <> v_current.remote_revision THEN
  553:       RAISE EXCEPTION 'VNEXT_MUTATION_REPLAY_STALE: mutation is no longer latest'
  554:         USING ERRCODE = '40001';
  555:     END IF;
  556:     IF v_replay.operation <> 'save'
  557:       OR v_replay.expected_remote_revision IS DISTINCT FROM p_expected_remote_revision
  558:       OR v_replay.document_snapshot IS DISTINCT FROM p_document_snapshot
  559:     THEN
  560:       RAISE EXCEPTION 'VNEXT_MUTATION_REUSE: mutation id reused with divergent save payload'
  561:         USING ERRCODE = '40001';
  562:     END IF;
  563:     RETURN public.vnext_catalog_envelope_v1(v_current);
  564:   END IF;
  565: 
  566:   IF v_current.remote_revision <> p_expected_remote_revision THEN
  567:     RAISE EXCEPTION 'VNEXT_CONFLICT: expected revision %, current revision %',
  568:       p_expected_remote_revision,
  569:       v_current.remote_revision
  570:       USING ERRCODE = '40001';
  571:   END IF;
  572: 
  573:   PERFORM public.vnext_validate_snapshot_v1(v_catalog_id, p_document_snapshot);
  574: 
  575:   v_new_revision := v_current.remote_revision + 1;
  576:   UPDATE public.vnext_catalogs
  577:   SET remote_revision = v_new_revision,
  578:       last_mutation_id = v_mutation_id,
  579:       title = p_document_snapshot->>'title',
  580:       locale = p_document_snapshot->>'locale',
  581:       updated_at = now(),
  582:       updated_by = v_actor,
  583:       document_schema_version = 1,
  584:       document_snapshot = p_document_snapshot
  585:   WHERE id = v_catalog_id
  586:   RETURNING * INTO v_current;
  587: 
  588:   INSERT INTO public.vnext_catalog_revisions (
  589:     catalog_id,
  590:     revision,
  591:     mutation_id,
  592:     operation,
  593:     expected_remote_revision,
  594:     title,
  595:     locale,
  596:     archived_at,
  597:     origin_kind,
  598:     origin_id,
  599:     origin_revision,
  600:     document_schema_version,
  601:     document_snapshot,
  602:     actor_id
  603:   )
  604:   VALUES (
  605:     v_catalog_id,
  606:     v_new_revision,
  607:     v_mutation_id,
  608:     'save',
  609:     p_expected_remote_revision,
  610:     v_current.title,
  611:     v_current.locale,
  612:     v_current.archived_at,
  613:     v_current.origin_kind,
  614:     v_current.origin_id,
  615:     v_current.origin_revision,
  616:     1,
  617:     p_document_snapshot,
  618:     v_actor
  619:   );
  620: 
  621:   RETURN public.vnext_catalog_envelope_v1(v_current);
  622: END;
  623: $$;
