  156: 
  157:   updateAuthContext(authLineage: string, authorityScopeId: string): void {
  158:     if (this.workspace.getSnapshot().activeAuthorityScopeId !== authorityScopeId) {
  159:       this.recoveredOverlay = undefined;
  160:     }
  161:     this.workspace.updateAuthContext(authLineage, authorityScopeId);
  162:   }
  163: 
  164:   getRecoveredOverlay(openSessionId: string): AuthoringRecoveryOverlay | undefined {
  165:     return this.recoveredOverlay?.openSessionId === openSessionId
  166:       ? this.recoveredOverlay.overlay
  167:       : undefined;
  168:   }
  169: 
  170:   consumeRecoveredOverlay(openSessionId: string): void {
  171:     if (this.recoveredOverlay?.openSessionId === openSessionId) this.recoveredOverlay = undefined;
