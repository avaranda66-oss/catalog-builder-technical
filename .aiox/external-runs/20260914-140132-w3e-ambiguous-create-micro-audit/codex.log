41:class MemoryCatalogRepository implements CatalogRepository {
42:  private readonly catalogs = new Map<string, CatalogPersistenceEnvelope>();
43:  private tick = 0;
44:  beforeNextSave?: () => void;
45:  beforeNextArchive?: () => void;
46:  readonly listCatalogs = vi.fn(async (query = {}): Promise<PersistenceResult<readonly CatalogListItem[]>> => {
47:    const values = [...this.catalogs.values()]
48:      .filter((item) => query.includeArchived || item.archivedAt === null)
49:      .map(({ documentSnapshot: _snapshot, lastMutationId: _mutation, ...item }) => item);
50:    return { ok: true, value: values };
51:  });
52:  readonly getCatalog = vi.fn(async (catalogId: string): Promise<PersistenceResult<CatalogPersistenceEnvelope>> => {
53:    const value = this.catalogs.get(catalogId);
54:    return value ? { ok: true, value } : { ok: false, error: { code: 'NOT_FOUND' } };
55:  });
56:
57:  readonly createCatalog = vi.fn(async (request: CreateCatalogRequest): Promise<PersistenceResult<CatalogPersistenceEnvelope>> => {
58:    if (this.catalogs.has(request.documentSnapshot.id)) return { ok: false, error: { code: 'CONFLICT' } };
59:    const timestamp = this.timestamp();
60:    const envelope: CatalogPersistenceEnvelope = {
61:      catalogId: request.documentSnapshot.id,
62:      remoteRevision: 1,
63:      lastMutationId: request.mutationId,
64:      title: request.documentSnapshot.title,
65:      locale: request.documentSnapshot.locale,
66:      createdAt: timestamp,
67:      updatedAt: timestamp,
68:      createdBy: 'user-a',
69:      updatedBy: 'user-a',
70:      archivedAt: null,
71:      documentSchemaVersion: 1,
72:      documentSnapshot: request.documentSnapshot,
73:    };
74:    this.catalogs.set(envelope.catalogId, envelope);
75:    return { ok: true, value: envelope };
76:  });
77:
78:  readonly saveCAS = vi.fn(async (request: SaveCatalogCasRequest): Promise<PersistenceResult<CatalogPersistenceEnvelope>> => {
79:    this.beforeNextSave?.();
80:    this.beforeNextSave = undefined;
81:    const current = this.catalogs.get(request.catalogId);
82:    if (!current) return { ok: false, error: { code: 'NOT_FOUND' } };
83:    if (current.archivedAt) return { ok: false, error: { code: 'ARCHIVED' } };
84:    if (current.remoteRevision !== request.expectedRemoteRevision) return { ok: false, error: { code: 'CONFLICT' } };
85:    const envelope: CatalogPersistenceEnvelope = {
86:      ...current,
87:      remoteRevision: current.remoteRevision + 1,
88:      lastMutationId: request.mutationId,
89:      title: request.documentSnapshot.title,
90:      locale: request.documentSnapshot.locale,
91:      updatedAt: this.timestamp(),
92:      documentSnapshot: request.documentSnapshot,
93:    };
94:    this.catalogs.set(request.catalogId, envelope);
95:    return { ok: true, value: envelope };
96:  });
97:
98:  readonly archiveCAS = vi.fn(async (request: ArchiveCatalogCasRequest): Promise<PersistenceResult<CatalogPersistenceMetadata>> => {
99:    this.beforeNextArchive?.();
100:    this.beforeNextArchive = undefined;
101:    const current = this.catalogs.get(request.catalogId);
102:    if (!current) return { ok: false, error: { code: 'NOT_FOUND' } };
103:    if (current.archivedAt) return { ok: false, error: { code: 'ARCHIVED' } };
104:    if (current.remoteRevision !== request.expectedRemoteRevision) return { ok: false, error: { code: 'CONFLICT' } };
105:    const envelope: CatalogPersistenceEnvelope = {
106:      ...current,
107:      remoteRevision: current.remoteRevision + 1,
108:      lastMutationId: request.mutationId,
109:      archivedAt: this.timestamp(),
110:      updatedAt: this.timestamp(),
111:    };
112:    this.catalogs.set(request.catalogId, envelope);
113:    const { documentSnapshot: _snapshot, ...metadata } = envelope;
114:    return { ok: true, value: metadata };
115:  });
116:
117:  seed(envelope: CatalogPersistenceEnvelope): void {
118:    this.catalogs.set(envelope.catalogId, envelope);
119:  }
120:
121:  advance(catalogId: string): void {
122:    const current = this.catalogs.get(catalogId);
123:    if (!current) return;
124:    this.catalogs.set(catalogId, {
125:      ...current,
126:      remoteRevision: current.remoteRevision + 1,
127:      lastMutationId: uuid(9000 + current.remoteRevision),
128:      updatedAt: this.timestamp(),
129:    });
130:  }
131:
132:  current(catalogId: string): CatalogPersistenceEnvelope {
133:    const value = this.catalogs.get(catalogId);
134:    if (!value) throw new Error('missing catalog');
135:    return value;
136:  }
137:
138:  private timestamp(): string {
139:    this.tick += 1;
140:    return new Date(Date.UTC(2026, 8, 14, 12, 0, this.tick)).toISOString();
141:  }
142:}
