73:class BrowserLibraryRepository implements CatalogRepository {
74:  readonly records = new Map<string, CatalogPersistenceEnvelope>();
75:  listCalls = 0;
76:  getCalls = 0;
77:  private ambiguousArmed = false;
78:  private ambiguousAttempt?: CreateCatalogRequest;
79:  private ambiguousReplay?: CreateCatalogRequest;
80:  private ambiguousFirstVerificationNotFound = false;
81:  private ambiguousReplayAccepted = false;
82:
83:  constructor(initial: readonly CatalogPersistenceEnvelope[]) {
84:    for (const record of initial) this.records.set(record.catalogId, record);
85:  }
86:
87:  armAmbiguousCreate(): void {
88:    this.ambiguousArmed = true;
89:    this.ambiguousAttempt = undefined;
90:    this.ambiguousReplay = undefined;
91:    this.ambiguousFirstVerificationNotFound = false;
92:    this.ambiguousReplayAccepted = false;
93:  }
94:
95:  ambiguousCreateEvidence() {
96:    const first = this.ambiguousAttempt;
97:    const replay = this.ambiguousReplay;
98:    const sameDocument = Boolean(first && replay
99:      && canonicalDocumentEquivalence(first.documentSnapshot) === canonicalDocumentEquivalence(replay.documentSnapshot));
100:    const sameOrigin = Boolean(first && replay
101:      && JSON.stringify(first.origin ?? null) === JSON.stringify(replay.origin ?? null));
102:    const logicalCatalogCount = first
103:      ? [...this.records.values()].filter((record) => record.catalogId === first.documentSnapshot.id).length
104:      : 0;
105:    return {
106:      dispatches: Number(Boolean(first)) + Number(Boolean(replay)),
107:      firstVerificationNotFound: this.ambiguousFirstVerificationNotFound,
108:      replayAccepted: this.ambiguousReplayAccepted,
109:      firstCatalogId: first?.documentSnapshot.id ?? null,
110:      replayCatalogId: replay?.documentSnapshot.id ?? null,
111:      firstMutationId: first?.mutationId ?? null,
112:      replayMutationId: replay?.mutationId ?? null,
113:      sameDocument,
114:      sameOrigin,
115:      logicalCatalogCount,
116:    };
117:  }
118:
119:  listCatalogs = async (query: CatalogListQuery = {}): Promise<PersistenceResult<readonly CatalogListItem[]>> => {
120:    this.listCalls += 1;
121:    const value = [...this.records.values()]
122:      .filter((record) => query.includeArchived || record.archivedAt === null)
123:      .map(({ documentSnapshot: _snapshot, lastMutationId: _mutation, ...item }) => item);
124:    return { ok: true, value };
125:  };
126:
127:  getCatalog = async (catalogId: string): Promise<PersistenceResult<CatalogPersistenceEnvelope>> => {
128:    this.getCalls += 1;
129:    const record = this.records.get(catalogId);
130:    if (!record && this.ambiguousAttempt?.documentSnapshot.id === catalogId) {
131:      this.ambiguousFirstVerificationNotFound = true;
132:    }
133:    return record
134:      ? { ok: true, value: record }
135:      : { ok: false, error: { code: 'NOT_FOUND' } };
136:  };
137:
138:  createCatalog = async (request: CreateCatalogRequest): Promise<PersistenceResult<CatalogPersistenceEnvelope>> => {
139:    if (this.ambiguousArmed) {
140:      this.ambiguousArmed = false;
141:      this.ambiguousAttempt = request;
142:      return { ok: false, error: { code: 'AMBIGUOUS_COMMIT_OUTCOME' } };
143:    }
144:    if (
145:      this.ambiguousAttempt
146:      && !this.ambiguousReplayAccepted
147:      && request.documentSnapshot.id === this.ambiguousAttempt.documentSnapshot.id
