function uuid(value: number): string {
  return `00000000-0000-4000-8000-${String(value).padStart(12, '0')}`;
}

let generated = 1000;
const createId = (): string => uuid(++generated);
const dependencies: ApplicationExecutionDependencies = {
  createId,
