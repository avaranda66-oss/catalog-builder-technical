108:  const [renameTitle, setRenameTitle] = React.useState('');
109:  const [archiveTarget, setArchiveTarget] = React.useState<CatalogListItem | undefined>();
110:  const loadGeneration = React.useRef(0);
111:  const dialogTrigger = React.useRef<HTMLElement | null>(null);
112:  const renameDialog = React.useRef<HTMLFormElement | null>(null);
113:  const archiveDialog = React.useRef<HTMLElement | null>(null);
114:  const createPending = service.getCreateState() === 'pending-verification';
115:
116:  const rememberDialogTrigger = () => {
117:    dialogTrigger.current = document.activeElement instanceof HTMLElement ? document.activeElement : null;
118:  };
119:
120:  React.useEffect(() => {
121:    if (renameTarget || archiveTarget) return;
122:    const trigger = dialogTrigger.current;
123:    dialogTrigger.current = null;
124:    if (trigger?.isConnected) trigger.focus();
125:  }, [archiveTarget, renameTarget]);
126:
127:  const handleDialogKeyboard = (event: React.KeyboardEvent<HTMLElement>) => {
128:    if (event.key === 'Escape') {
129:      event.preventDefault();
130:      setRenameTarget(undefined);
131:      setArchiveTarget(undefined);
132:      return;
133:    }
134:    if (event.key !== 'Tab') return;
135:    const dialog = renameDialog.current ?? archiveDialog.current;
136:    if (!dialog) return;
137:    const focusable = [...dialog.querySelectorAll<HTMLElement>(
138:      'button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
139:    )].filter((element) => !element.hasAttribute('hidden'));
140:    if (focusable.length === 0) return;
141:    const first = focusable[0];
142:    const last = focusable[focusable.length - 1];
143:    const active = document.activeElement;
144:    if (event.shiftKey && (active === first || !dialog.contains(active))) {
145:      event.preventDefault();
146:      last.focus();
147:    } else if (!event.shiftKey && (active === last || !dialog.contains(active))) {
148:      event.preventDefault();
149:      first.focus();
150:    }
151:  };
152:
153:  const load = React.useCallback(async (nextView = view, nextSearch = search, nextSort = sort) => {
154:    const generation = ++loadGeneration.current;
155:    setLoading(true);
156:    setError(undefined);
157:    const result = await service.list({ view: nextView, search: nextSearch, sort: nextSort });
158:    if (generation !== loadGeneration.current) return;
159:    if (result.ok) setItems(result.value);
160:    else {
161:      setItems([]);
162:      setError(failureMessage(result.error.code, 'load'));
163:    }
164:    setLoading(false);
165:  }, [service, sort, search, view]);
166:
167:  React.useEffect(() => { void load(); }, [load]);
168:
169:  const changeView = (nextView: CatalogLibraryView) => {
170:    setView(nextView);
171:    setSearch('');
172:  };
173:
174:  const createBlank = async () => {
175:    if (busy) return;
176:    setBusy(true);
177:    setError(undefined);
178:    const result = await service.createBlank();
179:    setBusy(false);
180:    if (!result.ok) {
181:      setError(failureMessage(result.error.code, 'create'));
182:      return;
183:    }
184:    onOpen(result.value.catalogId);
185:  };
186:
187:  const submitRename = async (event: React.FormEvent) => {
188:    event.preventDefault();
189:    if (!renameTarget || busy) return;
190:    setBusy(true);
191:    setError(undefined);
192:    const result = await service.rename(renameTarget.catalogId, renameTitle);
193:    setBusy(false);
194:    if (!result.ok) {
195:      setError(failureMessage(result.error.code, 'rename'));
196:      if (result.error.code === 'CONFLICT' || result.error.code === 'STALE_RESULT' || result.error.code === 'ARCHIVED') {
197:        setRenameTarget(undefined);
198:        await load();
199:      }
200:      return;
201:    }
202:    setRenameTarget(undefined);
203:    await load();
204:  };
205:
206:  const confirmArchive = async () => {
207:    if (!archiveTarget || busy) return;
208:    const target = archiveTarget;
209:    setBusy(true);
210:    setError(undefined);
211:    const result = await service.archive(target.catalogId);
212:    setBusy(false);
213:    setArchiveTarget(undefined);
214:    if (!result.ok) {
215:      setError(failureMessage(result.error.code, 'archive'));
216:      await load();
217:      return;
218:    }
219:    setItems((current) => current.filter((item) => item.catalogId !== target.catalogId));
220:  };
221:
222:  const hasItems = items.length > 0;
223:  const emptySearch = !loading && !hasItems && search.trim().length > 0;
224:  const emptyView = !loading && !hasItems && !search.trim();
225:
226:  return (
227:    <main className="vnext-library-shell" data-catalog-library="" onKeyDown={handleDialogKeyboard}>
228:      <header className="vnext-library-header">
229:        <div className="vnext-brand">
230:          <div className="vnext-brand-mark" aria-hidden="true">P</div>
231:          <div>
232:            <div className="vnext-product-line">PRESYS · Catalog Builder</div>
233:            <h1>Catálogos</h1>
234:          </div>
235:        </div>
236:        <button type="button" className="vnext-library-create" onClick={() => { void createBlank(); }} disabled={busy}>
237:          <FilePlus2 size={18} aria-hidden="true" />
238:          {busy ? (createPending ? 'Verificando…' : 'Criando…') : (createPending ? 'Verificar criação' : 'Novo catálogo')}
239:        </button>
240:      </header>
241:
242:      <section className="vnext-library-content" aria-labelledby="library-heading">
243:        <div className="vnext-library-intro">
244:          <div>
245:            <span className="vnext-library-eyebrow">Biblioteca</span>
246:            <h2 id="library-heading">Seus catálogos técnicos</h2>
247:            <p>Encontre um catálogo, continue o trabalho ou comece um novo.</p>
248:          </div>
249:        </div>
250:
251:        <div className="vnext-library-toolbar">
252:          <div className="vnext-library-tabs" role="tablist" aria-label="Estado dos catálogos">
253:            <button type="button" role="tab" aria-selected={view === 'active'} className={view === 'active' ? 'is-selected' : undefined} onClick={() => changeView('active')}>Ativos</button>
254:            <button type="button" role="tab" aria-selected={view === 'archived'} className={view === 'archived' ? 'is-selected' : undefined} onClick={() => changeView('archived')}>Arquivados</button>
255:          </div>
256:          <div className="vnext-library-controls">
257:            <label className="vnext-library-search">
258:              <Search size={17} aria-hidden="true" />
259:              <span className="sr-only">Buscar catálogos</span>
260:              <input value={search} onChange={(event) => setSearch(event.target.value)} placeholder="Buscar catálogos" type="search" />
261:            </label>
262:            <label className="vnext-library-sort">
263:              <span className="sr-only">Ordenar catálogos</span>
264:              {sort === 'title-asc' ? <ArrowDownAZ size={17} aria-hidden="true" /> : sort === 'title-desc' ? <ArrowUpAZ size={17} aria-hidden="true" /> : <Clock3 size={17} aria-hidden="true" />}
265:              <select value={sort} onChange={(event) => setSort(event.target.value as CatalogLibrarySort)}>
266:                <option value="updated-desc">Mais recentes</option>
267:                <option value="title-asc">Título A–Z</option>
268:                <option value="title-desc">Título Z–A</option>
269:              </select>
270:            </label>
271:          </div>
272:        </div>
273:
274:        {error && (
275:          <div className="vnext-library-error" role="alert">
276:            <span>{error}</span>
277:            <button type="button" onClick={() => { if (createPending) void createBlank(); else void load(); }}>
278:              {createPending ? 'Verificar criação' : 'Tentar novamente'}
279:            </button>
280:          </div>
281:        )}
282:
283:        {loading ? (
284:          <div className="vnext-library-loading" role="status">Carregando catálogos…</div>
285:        ) : hasItems ? (
286:          <div className="vnext-library-list" aria-live="polite">
287:            {items.map((item) => (
288:              <CatalogRow
289:                key={item.catalogId}
290:                item={item}
291:                view={view}
292:                onOpen={() => onOpen(item.catalogId)}
293:                onRename={() => { rememberDialogTrigger(); setRenameTarget(item); setRenameTitle(item.title); }}
294:                onArchive={() => { rememberDialogTrigger(); setArchiveTarget(item); }}
295:              />
296:            ))}
297:          </div>
298:        ) : emptySearch ? (
299:          <div className="vnext-library-empty is-search">
300:            <Search size={24} aria-hidden="true" />
301:            <h3>Nenhum catálogo encontrado</h3>
302:            <p>Tente outro termo de busca.</p>
303:          </div>
304:        ) : emptyView && view === 'active' ? (
305:          <div className="vnext-library-empty">
306:            <FilePlus2 size={30} aria-hidden="true" />
307:            <h3>Comece seu primeiro catálogo</h3>
