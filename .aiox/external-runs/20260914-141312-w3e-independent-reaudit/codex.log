862:          <div className="vnext-brand-mark" aria-hidden="true">P</div>
863:          <div>
864:            <div className="vnext-product-line">PRESYS · Catalog Builder</div>
865:            <div className="vnext-title-row"><h1>{document.title}</h1><span className="vnext-badge">VNext</span></div>
866:          </div>
867:        </div>
868:        <div className="vnext-actions" aria-label="Ações do documento">
869:          {persistence && onRequestLibrary && (
870:            <button
871:              type="button"
872:              data-editor-action="library"
