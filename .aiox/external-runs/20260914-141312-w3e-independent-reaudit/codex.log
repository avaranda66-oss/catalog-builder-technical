58:  private readonly resolveAssetUrls: ((document: CatalogDocument) => ReadonlyMap<string, string>) | undefined;
59:
60:  constructor(options: VNextPersistenceRuntimeOptions) {
61:    this.resolveAssetUrls = options.resolveAssetUrls;
62:    const openSessionId = options.createOpenSessionId();
63:    const authorityScopeId = options.authorityScopeId ?? options.authLineage.split(':')[0];
64:    const binding = options.binding
65:      ? persistedBindingFromEnvelope(
66:          parsePersistenceEnvelope(options.binding),
67:          openSessionId,
68:          options.authLineage,
69:          authorityScopeId,
70:          options.session.getSnapshot().localSequence
71:        )
72:      : createUnboundPersistenceBinding(
73:          options.session,
74:          openSessionId,
75:          options.authLineage,
76:          authorityScopeId
77:        );
78:
79:    this.workspace = new PersistenceWorkspace(
80:      options.session,
81:      binding,
82:      options.assetUrls
83:    );
84:    this.recoveryCoordinator = options.recoveryRepository
85:      ? new RecoveryCoordinator({
86:          repository: options.recoveryRepository,
87:          applicationDependencies: options.applicationDependencies,
88:          createOpenSessionId: options.createOpenSessionId,
89:        })
90:      : undefined;
91:    this.recoveryManager = this.recoveryCoordinator
92:      ? new SessionRecoveryManager({
93:          coordinator: this.recoveryCoordinator,
94:          getSource: () => {
95:            const snapshot = this.workspace.getSnapshot();
96:            const { binding: activeBinding } = snapshot;
97:            const authoringRecoveryOverlay = this.workspace.captureRecoveryOverlay()
98:              ?? this.getRecoveredOverlay(activeBinding.openSessionId);
99:            return {
100:              ownerAuthorityScopeId: activeBinding.authorityScopeId,
101:              activeAuthorityScopeId: snapshot.activeAuthorityScopeId,
102:              catalogId: snapshot.session.getSnapshot().document.id,
103:              openSessionId: activeBinding.openSessionId,
104:              localEditSequence: snapshot.session.getSnapshot().localSequence,
105:              documentSnapshot: snapshot.session.getSnapshot().document,
106:              baseRemoteRevision: activeBinding.kind === 'PERSISTED' ? activeBinding.remoteRevision : 0,
107:              baseRemoteSnapshot: activeBinding.kind === 'PERSISTED'
108:                ? activeBinding.acknowledgedSnapshot
109:                : activeBinding.initialSnapshot,
110:              dirty: snapshot.dirty,
111:              ...(authoringRecoveryOverlay
112:                ? { authoringRecoveryOverlay }
113:                : {}),
114:            };
115:          },
116:          subscribe: this.workspace.subscribe,
117:          clock: options.recoveryClock,
118:          trailingMs: options.recoveryTrailingMs,
119:          maxWaitMs: options.recoveryMaxWaitMs,
120:          onProtectionAvailable: () => this.workspace.setLocalProtectionAvailable(),
121:          onProtectionUnavailable: () => this.workspace.setLocalProtectionUnavailable(),
122:        })
123:      : undefined;
124:    this.recoveryStartup = this.recoveryCoordinator
125:      ? new RecoveryStartupCoordinator({
126:          coordinator: this.recoveryCoordinator,
127:          repository: options.repository,
128:          getActiveAuthorityScopeId: () => this.workspace.getSnapshot().activeAuthorityScopeId,
129:        })
130:      : undefined;
131:    this.saveCoordinator = new SaveCoordinator({
132:      workspace: this.workspace,
133:      repository: options.repository,
134:      createMutationId: options.createMutationId,
135:      recoveryLifecycle: this.recoveryManager
136:        ? {
137:            beforeDispatch: (pending) => this.recoveryManager!.flushPendingMutation(pending),
138:            afterAcknowledged: (pending, envelope) => this.recoveryManager!.acknowledge(pending, envelope),
139:          }
140:        : undefined,
141:    });
142:    this.reopenCoordinator = new CanonicalReopenCoordinator({
143:      workspace: this.workspace,
144:      repository: options.repository,
145:      applicationDependencies: options.applicationDependencies,
146:      createOpenSessionId: options.createOpenSessionId,
147:      resolveAssetUrls: options.resolveAssetUrls,
148:      canLeave: () => !this.saveCoordinator.hasUnresolvedActiveMutation(),
149:    });
150:    this.recoveryManager?.start();
151:  }
152:
153:  updateAuthLineage(authLineage: string): void {
154:    this.workspace.updateAuthLineage(authLineage);
155:  }
156:
157:  updateAuthContext(authLineage: string, authorityScopeId: string): void {
158:    if (this.workspace.getSnapshot().activeAuthorityScopeId !== authorityScopeId) {
159:      this.recoveredOverlay = undefined;
160:    }
161:    this.workspace.updateAuthContext(authLineage, authorityScopeId);
162:  }
163:
164:  getRecoveredOverlay(openSessionId: string): AuthoringRecoveryOverlay | undefined {
165:    return this.recoveredOverlay?.openSessionId === openSessionId
166:      ? this.recoveredOverlay.overlay
167:      : undefined;
168:  }
169:
170:  consumeRecoveredOverlay(openSessionId: string): void {
171:    if (this.recoveredOverlay?.openSessionId === openSessionId) this.recoveredOverlay = undefined;
172:  }
