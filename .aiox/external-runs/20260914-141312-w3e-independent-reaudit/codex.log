131:export class SupabaseCatalogRepository implements CatalogRepository {
132:  private readonly isOffline: () => boolean;
133:
134:  constructor(
135:    private readonly client: VNextPersistenceRpcClient,
136:    options: SupabaseCatalogRepositoryOptions = {}
137:  ) {
138:    this.isOffline = options.isOffline ?? (() => typeof navigator !== 'undefined' && navigator.onLine === false);
139:  }
140:
141:  private async call<T>(
142:    functionName: string,
143:    args: Record<string, unknown>,
144:    kind: OperationKind,
145:    parse: (data: unknown) => T
146:  ): Promise<PersistenceResult<T>> {
147:    if (this.isOffline()) return failure('OFFLINE', 'Remote persistence is known to be offline before dispatch');
148:
149:    try {
150:      const response = await this.client.rpc(functionName, args);
151:      if (response.error) {
152:        const semanticError = mapSemanticRpcError(response.error);
153:        if (semanticError) return failure(semanticError, rpcMessage(response.error));
154:        if (isTransportLike(response.error)) {
155:          return failure(
156:            kind === 'mutation' ? 'AMBIGUOUS_COMMIT_OUTCOME' : 'REMOTE_FAILURE',
157:            rpcMessage(response.error)
158:          );
159:        }
160:        return failure('REMOTE_FAILURE', rpcMessage(response.error));
161:      }
162:      if (response.data === null || response.data === undefined) {
163:        return failure('REMOTE_FAILURE', `${functionName} returned no authoritative payload`);
164:      }
165:      try {
166:        return { ok: true, value: parse(response.data) };
167:      } catch (error) {
168:        return contractFailure(error);
169:      }
170:    } catch (error) {
171:      return failure(
172:        kind === 'mutation' ? 'AMBIGUOUS_COMMIT_OUTCOME' : 'REMOTE_FAILURE',
173:        error instanceof Error ? error.message : String(error)
174:      );
175:    }
176:  }
177:
178:  async listCatalogs(query: CatalogListQuery = {}): Promise<PersistenceResult<readonly CatalogListItem[]>> {
179:    return this.call(
180:      'list_vnext_catalogs_v1',
181:      { p_include_archived: query.includeArchived ?? false },
182:      'read',
183:      (data) => ListSchema.parse(data)
184:    );
185:  }
186:
187:  async getCatalog(catalogId: string): Promise<PersistenceResult<CatalogPersistenceEnvelope>> {
188:    const id = canonicalUuidOrFailure(catalogId, 'catalogId');
189:    if (!id.ok) return id;
190:    return this.call('get_vnext_catalog_v1', { p_catalog_id: id.value }, 'read', parsePersistenceEnvelope);
191:  }
192:
193:  async createCatalog(request: CreateCatalogRequest): Promise<PersistenceResult<CatalogPersistenceEnvelope>> {
194:    const mutation = canonicalUuidOrFailure(request.mutationId, 'mutationId');
195:    if (!mutation.ok) return mutation;
196:
197:    let documentSnapshot;
198:    try {
199:      documentSnapshot = parseCanonicalSnapshot(request.documentSnapshot);
200:      const compatibility = checkCatalogRootPersistenceCompatibility(documentSnapshot);
201:      if (!compatibility.compatible) {
202:        return failure('INVALID_DOCUMENT', `Catalog root ${compatibility.catalogId} is persistence-incompatible`);
203:      }
204:    } catch (error) {
205:      return contractFailure(error);
206:    }
207:
208:    return this.call(
209:      'create_vnext_catalog_v1',
210:      {
211:        p_mutation_id: mutation.value,
212:        p_document_snapshot: documentSnapshot,
213:        p_origin: request.origin ?? null,
214:      },
215:      'mutation',
216:      parsePersistenceEnvelope
217:    );
218:  }
219:
220:  async saveCAS(request: SaveCatalogCasRequest): Promise<PersistenceResult<CatalogPersistenceEnvelope>> {
221:    const catalog = canonicalUuidOrFailure(request.catalogId, 'catalogId');
222:    if (!catalog.ok) return catalog;
223:    const mutation = canonicalUuidOrFailure(request.mutationId, 'mutationId');
224:    if (!mutation.ok) return mutation;
225:    if (!Number.isSafeInteger(request.expectedRemoteRevision) || request.expectedRemoteRevision <= 0) {
226:      return failure('INVALID_DOCUMENT', 'expectedRemoteRevision must be a positive safe integer');
227:    }
228:
229:    let documentSnapshot;
230:    try {
231:      documentSnapshot = parseCanonicalSnapshot(request.documentSnapshot);
232:      if (documentSnapshot.id !== catalog.value) {
233:        return failure('ENVELOPE_MISMATCH', 'catalogId does not match documentSnapshot.id');
234:      }
235:    } catch (error) {
236:      return contractFailure(error);
237:    }
238:
239:    return this.call(
240:      'save_vnext_catalog_cas_v1',
241:      {
242:        p_catalog_id: catalog.value,
243:        p_expected_remote_revision: request.expectedRemoteRevision,
244:        p_mutation_id: mutation.value,
245:        p_document_snapshot: documentSnapshot,
246:      },
247:      'mutation',
248:      parsePersistenceEnvelope
249:    );
250:  }
251:
252:  async archiveCAS(request: ArchiveCatalogCasRequest): Promise<PersistenceResult<CatalogPersistenceMetadata>> {
253:    const catalog = canonicalUuidOrFailure(request.catalogId, 'catalogId');
254:    if (!catalog.ok) return catalog;
255:    const mutation = canonicalUuidOrFailure(request.mutationId, 'mutationId');
256:    if (!mutation.ok) return mutation;
257:    if (!Number.isSafeInteger(request.expectedRemoteRevision) || request.expectedRemoteRevision <= 0) {
258:      return failure('INVALID_DOCUMENT', 'expectedRemoteRevision must be a positive safe integer');
259:    }
260:
261:    return this.call(
262:      'archive_vnext_catalog_cas_v1',
263:      {
264:        p_catalog_id: catalog.value,
265:        p_expected_remote_revision: request.expectedRemoteRevision,
266:        p_mutation_id: mutation.value,
267:      },
268:      'mutation',
269:      (data) => MetadataSchema.parse(data)
