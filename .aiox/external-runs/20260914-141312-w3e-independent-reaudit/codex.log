790:
791:  const cancelOnRootBlur = (event: React.FocusEvent<HTMLDivElement>) => {
792:    const next = event.relatedTarget as Node | null;
793:    if (controller.isActive() && (!next || !event.currentTarget.contains(next))) {
794:      controller.cancel('focus-loss');
