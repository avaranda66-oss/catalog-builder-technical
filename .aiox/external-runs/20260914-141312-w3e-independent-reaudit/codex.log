374:  prepareTextDraftForSaveRef.current = prepareTextDraftForSave;
375:  const captureRecoveryOverlay = (): AuthoringRecoveryOverlay | undefined => {
376:    const edit = textEditRef.current;
377:    if (edit) {
378:      return {
379:        kind: 'TEXT_DRAFT_V1',
380:        pageId: edit.pageId,
381:        objectId: edit.objectId,
382:        expectedText: edit.expectedText,
383:        draft: edit.draft,
384:        compositionWasActive: compositionRef.current,
385:      };
386:    }
387:    const target = inspectorTargetRef.current;
388:    if (!target) return undefined;
389:    const draft = inspectorDraftRef.current;
390:    const canonical = {
391:      x: String(target.expectedFrame.xMm),
392:      y: String(target.expectedFrame.yMm),
393:      width: String(target.expectedFrame.widthMm),
394:      height: String(target.expectedFrame.heightMm),
395:    };
396:    if (
397:      draft.x === canonical.x
398:      && draft.y === canonical.y
399:      && draft.width === canonical.width
400:      && draft.height === canonical.height
401:    ) return undefined;
402:    return {
403:      kind: 'INSPECTOR_FRAME_DRAFT_V1',
404:      pageId: target.pageId,
405:      objectId: target.objectId,
406:      expectedFrame: target.expectedFrame,
407:      draft,
408:    };
409:  };
410:  const captureRecoveryOverlayRef = React.useRef(captureRecoveryOverlay);
411:  captureRecoveryOverlayRef.current = captureRecoveryOverlay;
412:  const prepareAuthoringForSave = (): AuthoringBarrierResult => {
413:    const textResult = prepareTextDraftForSaveRef.current();
414:    if (!textResult.ok) return textResult;
415:    if (captureRecoveryOverlayRef.current()?.kind === 'INSPECTOR_FRAME_DRAFT_V1') {
416:      setStatusMessage('Conclua ou reverta a edição do Inspector antes de salvar.');
417:      return {
418:        ok: false,
419:        reason: 'INVALID_DRAFT',
420:        message: 'O rascunho do Inspector foi preservado e precisa ser concluído antes de salvar.',
421:      };
422:    }
423:    return { ok: true };
424:  };
425:  const prepareAuthoringForSaveRef = React.useRef(prepareAuthoringForSave);
426:  prepareAuthoringForSaveRef.current = prepareAuthoringForSave;
427:  const persistenceRuntime = persistence?.runtime;
428:  const persistenceOpenSessionId = persistence?.openSessionId;
429:  React.useEffect(() => {
430:    if (!persistenceRuntime || !persistenceOpenSessionId) return undefined;
431:    return persistenceRuntime.registerAuthoringBarrier(persistenceOpenSessionId, {
432:      prepareForSave: () => prepareAuthoringForSaveRef.current(),
433:      hasPendingDraft: () => Boolean(captureRecoveryOverlayRef.current()),
434:      captureRecoveryOverlay: () => captureRecoveryOverlayRef.current(),
435:    });
436:  }, [persistenceOpenSessionId, persistenceRuntime]);
437:
438:  const recoveredOverlay = persistence?.recoveredOverlay;
439:  const restoredOverlayRef = React.useRef<AuthoringRecoveryOverlay | undefined>(undefined);
440:  React.useEffect(() => {
441:    if (!recoveredOverlay || restoredOverlayRef.current === recoveredOverlay) return;
442:    restoredOverlayRef.current = recoveredOverlay;
443:    const page = session.getSnapshot().document.pages.find(
444:      (entry) => entry.id === recoveredOverlay.pageId
445:    );
446:    const object = page?.objects.find((entry) => entry.id === recoveredOverlay.objectId);
447:    let restored = false;
448:    if (
449:      recoveredOverlay.kind === 'TEXT_DRAFT_V1'
450:      && object?.type === 'text'
451:      && JSON.stringify(object.text) === JSON.stringify(recoveredOverlay.expectedText)
452:    ) {
453:      const edit: TextEditSession = {
454:        pageId: recoveredOverlay.pageId,
455:        objectId: recoveredOverlay.objectId,
456:        expectedText: recoveredOverlay.expectedText,
457:        draft: recoveredOverlay.draft,
458:      };
459:      textEditRef.current = edit;
460:      compositionRef.current = false;
461:      setTextEdit(edit);
462:      setEditorState({
463:        activePageId: recoveredOverlay.pageId,
464:        selectedObjectIds: [recoveredOverlay.objectId],
465:        mode: 'text-edit',
466:      });
467:      restored = true;
468:    } else if (
469:      recoveredOverlay.kind === 'INSPECTOR_FRAME_DRAFT_V1'
470:      && object
471:      && JSON.stringify(object.frame) === JSON.stringify(recoveredOverlay.expectedFrame)
472:    ) {
473:      inspectorDraftRef.current = recoveredOverlay.draft;
474:      setInspectorDraft(recoveredOverlay.draft);
475:      setEditorState({
476:        activePageId: recoveredOverlay.pageId,
477:        selectedObjectIds: [recoveredOverlay.objectId],
478:        mode: 'select',
479:      });
480:      restored = true;
481:    }
482:    persistenceRuntime?.consumeRecoveredOverlay(persistenceOpenSessionId!);
483:    setStatusMessage(restored
484:      ? 'Rascunho local recuperado. Confirme ou cancele antes de salvar.'
485:      : 'O rascunho local não pôde ser aplicado porque o objeto mudou.');
486:    persistenceRuntime?.workspace.notifyDraftStateChanged();
487:  }, [persistenceOpenSessionId, persistenceRuntime, recoveredOverlay, session]);
488:
489:  const startTextEdit = (object: EditorialObject): boolean => {
490:    if (object.type !== 'text') return false;
491:    if (object.locked) {
492:      setStatusMessage('Texto bloqueado não pode ser editado.');
493:      return false;
494:    }
495:    const plainText = projectEditableRichText(object.text);
496:    if (plainText === null) {
497:      setStatusMessage('Este texto possui formatação estrutural complexa e não pode ser editado pelo modo simples.');
498:      return false;
499:    }
500:    controller.cancel('superseded');
501:    const edit: TextEditSession = {
502:      objectId: object.id,
503:      pageId: selectedPage.id,
504:      expectedText: object.text,
505:      draft: plainText,
506:    };
507:    textEditRef.current = edit;
508:    setTextEdit(edit);
509:    setEditorState({ activePageId: selectedPage.id, selectedObjectIds: [object.id], mode: 'text-edit' });
510:    setStatusMessage(null);
511:    persistence?.runtime.workspace.notifyDraftStateChanged();
512:    return true;
513:  };
514:
515:  const finishTextEditBeforeCommand = (): boolean => !textEditRef.current || commitTextEdit();
516:
517:  const toggleObjectSelection = (objectId: string) => {
518:    setEditorState((current) => {
519:      const selected = new Set(current.selectedObjectIds);
520:      if (selected.has(objectId)) selected.delete(objectId); else selected.add(objectId);
521:      return { ...current, selectedObjectIds: [...selected], mode: 'select' };
522:    });
523:  };
