649:
650:  const beginGesture = (event: React.PointerEvent<HTMLElement>, object: EditorialObject, kind: GestureKind) => {
651:    if (event.button !== 0) return;
652:    event.preventDefault();
653:    event.stopPropagation();
654:    if (textEditRef.current) return;
655:    if (kind.type === 'move' && object.type === 'text') {
656:      const selected = editorState.selectedObjectIds.length === 1 && editorState.selectedObjectIds[0] === object.id;
657:      const previous = lastTextPointerDownRef.current;
658:      const isSecondActivation = selected && (
659:        event.detail >= 2
660:        || Boolean(
661:          previous
662:          && previous.objectId === object.id
663:          && event.timeStamp - previous.timeStamp >= 0
664:          && event.timeStamp - previous.timeStamp <= 500
665:          && Math.hypot(event.clientX - previous.clientX, event.clientY - previous.clientY) <= 8
666:        )
667:      );
668:      lastTextPointerDownRef.current = {
669:        objectId: object.id,
670:        timeStamp: event.timeStamp,
671:        clientX: event.clientX,
672:        clientY: event.clientY,
673:      };
674:      if (isSecondActivation) {
675:        controller.cancel('superseded');
676:        startTextEdit(object);
677:        return;
678:      }
679:    }
680:    if (kind.type === 'move' && (event.ctrlKey || event.metaKey)) {
681:      controller.cancel('superseded');
682:      toggleObjectSelection(object.id);
683:      event.currentTarget.focus();
684:      return;
685:    }
686:    if (kind.type === 'resize' && object.type === 'group') return;
687:    selectObject(object.id);
688:    event.currentTarget.focus();
689:    const stage = event.currentTarget.closest('[data-vnext-page-stage]') as HTMLElement | null;
690:    const canonicalPage = stage?.querySelector<HTMLElement>('[data-editorial-root] [data-page-id]');
691:    const rect = canonicalPage?.getBoundingClientRect();
692:    if (!rect) return;
693:    try {
694:      const started = controller.begin({
695:        pointerId: event.pointerId, objectId: object.id, pageId: selectedPage.id, kind,
696:        clientX: event.clientX, clientY: event.clientY, pageClientWidthPx: rect.width, pageClientHeightPx: rect.height,
697:        snapThresholdPx: SNAP_RADIUS_PX,
698:      });
699:      if (!started) { setStatusMessage('Este objeto não pode ser movido agora.'); return; }
700:      event.currentTarget.setPointerCapture?.(event.pointerId);
701:      setStatusMessage(null);
702:    } catch {
703:      controller.cancel('capture-loss');
704:      setStatusMessage('Gesto cancelado.');
705:    }
706:  };
