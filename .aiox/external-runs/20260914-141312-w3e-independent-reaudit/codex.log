229:async function editSaveReopen(catalogId: string) {
230:  const current = repository.records.get(catalogId);
231:  if (!current) throw new Error(`Missing proof catalog ${catalogId}`);
232:  const runtime = createRuntime(current);
233:  const beforePages = runtime.workspace.getSnapshot().session.getSnapshot().document.pages.length;
234:  const edited = runtime.workspace.getSnapshot().session.execute({ type: 'page.add' });
235:  if (!edited.ok) throw new Error(`Proof edit rejected: ${edited.error.code}`);
236:  const saved = await runtime.saveCoordinator.save();
237:  if (!saved.ok) throw new Error(`Proof save rejected: ${saved.error.code}`);
238:  const authoritativeAfterSave = repository.records.get(catalogId);
239:  if (!authoritativeAfterSave) throw new Error('Saved catalog disappeared');
240:
241:  const reopenedRuntime = createRuntime();
242:  const reopened = await reopenedRuntime.reopenCoordinator.open(catalogId, { allowDiscardUnsaved: true });
243:  if (!reopened.ok) throw new Error(`Proof reopen rejected: ${reopened.error.code}`);
244:  return {
245:    beforePages,
246:    afterSavePages: authoritativeAfterSave.documentSnapshot.pages.length,
247:    reopenedPages: reopenedRuntime.workspace.getSnapshot().session.getSnapshot().document.pages.length,
248:    remoteRevision: authoritativeAfterSave.remoteRevision,
249:  };
250:}
