126:function projection(
127:  binding: PersistenceBinding,
128:  dirty: boolean,
129:  phase: SavePhase,
130:  message?: string
131:): SaveProjection {
132:  const withMessage = message ? { message } : {};
133:  if (phase === 'saving') return { phase, label: 'Saving…', dirty, canSave: false, ...withMessage };
134:  if (phase === 'conflict') return { phase, label: 'Conflict', dirty: true, canSave: false, ...withMessage };
135:  if (phase === 'ambiguous') return { phase, label: 'Could not verify save', dirty: true, canSave: true, ...withMessage };
136:  if (phase === 'unavailable' || phase === 'unauthorized') {
137:    return {
138:      phase,
139:      label: 'Offline / unavailable',
140:      dirty,
141:      canSave: binding.kind === 'PERSISTED',
142:      ...withMessage,
143:    };
144:  }
145:  if (phase === 'blocked') return { phase, label: 'Unsaved changes', dirty: true, canSave: true, ...withMessage };
146:  if (dirty) return { phase: 'idle', label: 'Unsaved changes', dirty: true, canSave: binding.kind === 'PERSISTED' };
147:  if (binding.kind === 'PERSISTED') return { phase: 'idle', label: 'Saved', dirty: false, canSave: true };
148:  return { phase: 'idle', label: 'Save', dirty: false, canSave: false };
149:}
