292:  private async dispatchAttempt(attempt: SaveAttempt): Promise<ManualSaveResult> {
293:    let result: PersistenceResult<CatalogPersistenceEnvelope>;
294:    try {
295:      result = await this.options.repository.saveCAS(attempt.request);
296:    } catch (error) {
297:      if (!this.isCurrent(attempt)) {
298:        this.ambiguousAttempt = attempt;
299:        return { ok: false, error: { code: 'STALE_RESULT' } };
300:      }
301:      this.ambiguousAttempt = attempt;
302:      this.options.workspace.setPhase(
303:        'ambiguous',
304:        error instanceof Error ? error.message : 'Could not verify whether the dispatched save committed'
305:      );
306:      return this.reconcileAmbiguous(attempt);
307:    }
308:
309:    if (result.ok) {
310:      if (!this.isCurrent(attempt)) {
311:        this.ambiguousAttempt = attempt;
312:        return { ok: false, error: { code: 'STALE_RESULT' } };
313:      }
314:      return this.acceptEnvelope(attempt, result.value);
315:    }
316:    if (result.error.code !== 'AMBIGUOUS_COMMIT_OUTCOME') {
317:      return this.handleKnownFailure(attempt, result.error.code, result.error.message);
318:    }
319:    if (!this.isCurrent(attempt)) {
320:      this.ambiguousAttempt = attempt;
321:      return { ok: false, error: { code: 'STALE_RESULT' } };
322:    }
323:    this.ambiguousAttempt = attempt;
324:    return this.reconcileAmbiguous(attempt);
325:  }
326:
327:  private async reconcileAmbiguous(attempt: SaveAttempt): Promise<ManualSaveResult> {
328:    if (!this.isCurrent(attempt)) return { ok: false, error: { code: 'STALE_RESULT' } };
329:    this.options.workspace.setPhase('ambiguous', 'Verifying the previous save');
330:
331:    let read: PersistenceResult<CatalogPersistenceEnvelope>;
332:    try {
333:      read = await this.options.repository.getCatalog(attempt.request.catalogId);
334:    } catch (error) {
335:      this.ambiguousAttempt = attempt;
336:      const message = error instanceof Error ? error.message : String(error);
337:      this.options.workspace.setPhase('ambiguous', message);
338:      return { ok: false, error: { code: 'AMBIGUOUS_COMMIT_OUTCOME', message } };
339:    }
340:    if (!this.isCurrent(attempt)) return { ok: false, error: { code: 'STALE_RESULT' } };
341:    if (!read.ok) {
342:      this.ambiguousAttempt = attempt;
343:      this.options.workspace.setPhase('ambiguous', read.error.message ?? 'Could not verify save');
344:      return {
345:        ok: false,
346:        error: { code: 'AMBIGUOUS_COMMIT_OUTCOME', message: read.error.message },
347:      };
348:    }
349:
350:    let authoritative: CatalogPersistenceEnvelope;
351:    try {
352:      authoritative = parsePersistenceEnvelope(read.value);
353:    } catch (error) {
354:      this.ambiguousAttempt = undefined;
355:      const message = error instanceof Error ? error.message : String(error);
356:      this.options.workspace.setPhase('conflict', message);
357:      return { ok: false, error: { code: 'REMOTE_DIVERGENCE', message } };
358:    }
359:    if (authoritative.lastMutationId === attempt.request.mutationId) {
360:      return this.acceptEnvelope(attempt, authoritative);
361:    }
362:    if (authoritative.remoteRevision > attempt.request.expectedRemoteRevision) {
363:      this.ambiguousAttempt = undefined;
364:      this.options.workspace.setPhase('conflict', 'The server advanced with a different mutation');
365:      return { ok: false, error: { code: 'CONFLICT' } };
366:    }
367:    if (
368:      authoritative.remoteRevision !== attempt.request.expectedRemoteRevision
369:      || authoritative.lastMutationId !== attempt.previousLastMutationId
370:    ) {
371:      this.ambiguousAttempt = undefined;
372:      this.options.workspace.setPhase(
373:        'conflict',
374:        'Authoritative state diverged while reconciling save'
375:      );
376:      return { ok: false, error: { code: 'CONFLICT' } };
377:    }
378:
379:    const [authoritativeDigest, expectedBaseDigest] = await Promise.all([
380:      digestCanonicalDocument(authoritative.documentSnapshot),
381:      attempt.baseRemoteSnapshotDigest
382:        ? Promise.resolve(attempt.baseRemoteSnapshotDigest)
383:        : digestCanonicalDocument(attempt.baseRemoteSnapshot),
384:    ]);
385:    if (authoritativeDigest !== expectedBaseDigest) {
386:      this.ambiguousAttempt = undefined;
387:      this.options.workspace.setPhase(
388:        'conflict',
389:        'Authoritative state digest does not match the captured remote base'
390:      );
391:      return { ok: false, error: { code: 'REMOTE_DIVERGENCE' } };
392:    }
393:
394:    let replay: PersistenceResult<CatalogPersistenceEnvelope>;
395:    try {
396:      replay = await this.options.repository.saveCAS(attempt.request);
397:    } catch (error) {
398:      this.ambiguousAttempt = attempt;
399:      const message = error instanceof Error ? error.message : String(error);
400:      this.options.workspace.setPhase('ambiguous', message);
401:      return { ok: false, error: { code: 'AMBIGUOUS_COMMIT_OUTCOME', message } };
402:    }
403:    if (!this.isCurrent(attempt)) return { ok: false, error: { code: 'STALE_RESULT' } };
404:    if (replay.ok) return this.acceptEnvelope(attempt, replay.value);
405:    if (
406:      replay.error.code === 'AMBIGUOUS_COMMIT_OUTCOME'
407:      || replay.error.code === 'OFFLINE'
408:      || replay.error.code === 'REMOTE_FAILURE'
409:    ) {
410:      this.ambiguousAttempt = attempt;
411:      this.options.workspace.setPhase('ambiguous', replay.error.message ?? 'Could not verify save');
412:      return {
413:        ok: false,
414:        error: { code: 'AMBIGUOUS_COMMIT_OUTCOME', message: replay.error.message },
415:      };
416:    }
417:    this.ambiguousAttempt = undefined;
418:    return this.handleKnownFailure(attempt, replay.error.code, replay.error.message);
419:  }
420:}

