813:
814:  const updateTextDraft = (value: string) => {
815:    const current = textEditRef.current;
816:    if (!current) return;
817:    const next = { ...current, draft: value.replace(/\r\n?/g, '\n') };
818:    textEditRef.current = next;
819:    setTextEdit(next);
820:    persistence?.runtime.workspace.notifyDraftStateChanged();
821:  };
822:
823:  const insertTechnicalSymbol = (symbol: string) => {
824:    const edit = textEditRef.current;
825:    const textarea = textAreaRef.current;
826:    if (!edit || !textarea) return;
827:    const start = textarea.selectionStart ?? edit.draft.length;
828:    const end = textarea.selectionEnd ?? start;
829:    const nextDraft = edit.draft.slice(0, start) + symbol + edit.draft.slice(end);
830:    const nextEdit = { ...edit, draft: nextDraft };
831:    const caret = start + symbol.length;
832:    textEditRef.current = nextEdit;
833:    setTextEdit(nextEdit);
834:    persistence?.runtime.workspace.notifyDraftStateChanged();
835:    queueMicrotask(() => {
836:      const current = textAreaRef.current;
837:      if (!current) return;
838:      current.focus();
839:      current.setSelectionRange(caret, caret);
840:    });
841:  };
842:
843:  const updateInspectorDraft = (field: keyof InspectorDraft, value: string) => {
844:    const next = { ...inspectorDraftRef.current, [field]: value };
845:    inspectorDraftRef.current = next;
846:    setInspectorDraft(next);
847:    persistence?.runtime.workspace.notifyDraftStateChanged();
848:  };
849:
850:  return (
851:    <div
852:      className="vnext-shell"
853:      data-vnext-shell=""
854:      data-active-page-id={selectedPage.id}
855:      data-editor-mode={editorState.mode}
856:      onPointerDownCapture={handleTextEditPointerDownCapture}
