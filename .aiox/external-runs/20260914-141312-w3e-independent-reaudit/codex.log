247:    const read = await this.options.repository.getCatalog(catalogId);
248:    if (!this.authorityIsCurrent(authority)) return this.staleAuthority();
249:    if (!read.ok) return failure(read.error.code, read.error.message);
250:    let envelope: CatalogPersistenceEnvelope;
251:    try {
252:      envelope = parsePersistenceEnvelope(read.value);
253:    } catch (error) {
254:      return failure('INVALID_DOCUMENT', error instanceof Error ? error.message : String(error));
255:    }
256:    if (envelope.catalogId !== catalogId || envelope.documentSnapshot.id !== catalogId) {
257:      return failure('ENVELOPE_MISMATCH', 'Requested catalog identity does not match the authoritative document');
258:    }
259:    if (!this.authorityIsCurrent(authority)) return this.staleAuthority();
260:    const archived = await this.options.repository.archiveCAS({
261:      mutationId: this.options.createMutationId(),
262:      catalogId,
263:      expectedRemoteRevision: envelope.remoteRevision,
264:    });
265:    if (!this.authorityIsCurrent(authority)) return this.staleAuthority();
266:    if (!archived.ok) return failure(archived.error.code, archived.error.message);
267:    return { ok: true, value: archived.value };
268:  }
269:}

