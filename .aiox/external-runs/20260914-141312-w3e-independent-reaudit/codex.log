174:  private captureRecoveryInstallGuard(
175:    candidate: RecoveryStartupCandidate
176:  ): RecoveryInstallGuard | undefined {
177:    if (
178:      candidate.inspection.status !== 'VALID'
179:      || candidate.inspection.record.pendingRemoteMutation
180:      || candidate.decision.kind !== 'RECOVERABLE_OVER_SAME_REMOTE_BASE'
181:    ) return undefined;
182:    const snapshot = this.workspace.getSnapshot();
183:    const binding = snapshot.binding;
184:    const sessionSnapshot = snapshot.session.getSnapshot();
185:    const barrier = this.workspace.getAuthoringBarrier();
186:    const remote = candidate.decision.remote;
187:    const remoteEquivalence = canonicalDocumentEquivalence(remote.documentSnapshot);
188:    const currentEquivalence = canonicalDocumentEquivalence(sessionSnapshot.document);
189:    if (
190:      binding.kind !== 'PERSISTED'
191:      || snapshot.activeAuthorityScopeId !== candidate.inspection.key.authorityScopeId
192:      || binding.authorityScopeId !== candidate.inspection.key.authorityScopeId
193:      || binding.catalogId !== candidate.inspection.key.catalogId
194:      || sessionSnapshot.document.id !== candidate.inspection.key.catalogId
195:      || remote.catalogId !== candidate.inspection.key.catalogId
196:      || candidate.inspection.record.baseRemoteRevision !== remote.remoteRevision
197:      || binding.remoteRevision !== remote.remoteRevision
198:      || binding.lastMutationId !== remote.lastMutationId
199:      || binding.acknowledgedEquivalence !== remoteEquivalence
200:      || currentEquivalence !== remoteEquivalence
201:      || snapshot.dirty
202:      || barrier.hasPendingDraft()
203:      || this.getRecoveredOverlay(binding.openSessionId)
204:      || snapshot.save.phase !== 'idle'
205:      || this.saveCoordinator.hasUnresolvedActiveMutation()
206:    ) return undefined;
207:    return {
208:      session: snapshot.session,
209:      authoringBarrier: barrier,
210:      openSessionId: binding.openSessionId,
211:      authLineage: binding.authLineage,
212:      authorityScopeId: snapshot.activeAuthorityScopeId,
213:      remoteRevision: binding.remoteRevision,
214:      lastMutationId: binding.lastMutationId,
215:      localSequence: sessionSnapshot.localSequence,
216:      documentEquivalence: currentEquivalence,
217:    };
218:  }
219:
220:  private recoveryInstallGuardIsCurrent(
221:    candidate: RecoveryStartupCandidate,
222:    expected: RecoveryInstallGuard
223:  ): boolean {
224:    const current = this.captureRecoveryInstallGuard(candidate);
225:    return Boolean(
226:      current
227:      && current.session === expected.session
228:      && current.authoringBarrier === expected.authoringBarrier
229:      && current.openSessionId === expected.openSessionId
230:      && current.authLineage === expected.authLineage
231:      && current.authorityScopeId === expected.authorityScopeId
232:      && current.remoteRevision === expected.remoteRevision
233:      && current.lastMutationId === expected.lastMutationId
234:      && current.localSequence === expected.localSequence
235:      && current.documentEquivalence === expected.documentEquivalence
236:    );
237:  }
