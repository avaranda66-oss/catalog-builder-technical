+.vnext-library-tabs { display: flex; gap: 4px; }
+.vnext-library-tabs button { min-height: 40px; border: 0; border-radius: 6px; background: transparent; color: #5e6d80; cursor: pointer; font: inherit; font-size: 13px; font-weight: 700; padding: 0 14px; }
+.vnext-library-tabs button:hover { background: #e9eef4; }
+.vnext-library-tabs button.is-selected { background: #e6f0f9; color: #003f78; }
