+.vnext-library-dialog label input:focus { border-color: #0072ce; box-shadow: 0 0 0 3px rgb(0 114 206 / .13); }
+.vnext-library-dialog-close { position: absolute; right: 18px; top: 18px; display: grid; width: 36px; height: 36px; place-items: center; border: 0; border-radius: 6px; background: transparent; color: #657488; cursor: pointer; }
+.vnext-library-dialog-close:hover { background: #eef2f6; }
