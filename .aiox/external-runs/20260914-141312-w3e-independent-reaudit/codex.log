798:
799:  const handleTextEditPointerDownCapture = (event: React.PointerEvent<HTMLDivElement>) => {
800:    if (!textEditRef.current) return;
801:    const target = event.target as HTMLElement;
802:    if (target.closest('[data-text-edit-session]')) return;
803:    if (target.closest('[data-persistence-save-action]')) return;
804:    if (target.closest('[data-text-edit-cancel-on-activate]')) {
