559:    const result = session.redo();
560:    setStatusMessage(result.ok ? 'Alteração refeita.' : 'Não há alterações para refazer.');
561:  };
562:
563:  const insertObject = (tool: InsertTool) => {
564:    if (!finishTextEditBeforeCommand()) return;
565:    controller.cancel('superseded');
566:    const currentPage = session.getSnapshot().document.pages.find((page) => page.id === editorState.activePageId);
567:    if (!currentPage) return;
568:    const result = session.execute({ type: 'object.insert', pageId: currentPage.id, object: createInsertSpec(tool, currentPage) });
569:    if (!result.ok) { setStatusMessage('Não foi possível inserir o objeto.'); return; }
570:    const objectId = result.metadata.createdIds[0];
571:    if (objectId) selectObject(objectId);
572:    const names: Record<InsertTool, string> = { text: 'Texto', image: 'Imagem', table: 'Tabela', shape: 'Forma', line: 'Linha' };
573:    setStatusMessage(names[tool] + ' adicionada.');
574:  };
575:
576:  const deleteSelected = () => {
577:    if (!selectedObject) return;
578:    if (!finishTextEditBeforeCommand()) return;
579:    controller.cancel('superseded');
580:    const result = session.execute({ type: 'object.delete', objectId: selectedObject.id });
581:    if (!result.ok) { setStatusMessage('Não foi possível excluir o objeto.'); return; }
582:    setEditorState((current) => ({ ...current, selectedObjectIds: [] }));
583:    setStatusMessage('Objeto excluído.');
584:  };
585:
586:  const duplicateSelected = () => {
587:    if (!selectedObject) return;
588:    if (!finishTextEditBeforeCommand()) return;
589:    controller.cancel('superseded');
590:    const result = session.execute({ type: 'object.duplicate', objectId: selectedObject.id });
591:    if (!result.ok) { setStatusMessage('Não foi possível duplicar o objeto.'); return; }
592:    const objectId = result.metadata.createdIds[0];
593:    if (objectId) selectObject(objectId);
594:    setStatusMessage('Objeto duplicado.');
