212:async function openFromLibrary(catalogId: string): Promise<void> {
213:  lastOpenedCatalogId = catalogId;
214:  const withRecovery = recoveryTargetCatalogId === catalogId;
215:  const runtime = createRuntime(undefined, withRecovery);
216:  const opened = await runtime.reopenCoordinator.open(catalogId, { allowDiscardUnsaved: true });
217:  lastCanonicalOpen = opened.ok
218:    ? { catalogId, ok: true }
219:    : { catalogId, ok: false, code: opened.error.code };
220:  if (opened.ok && withRecovery) {
221:    rootRenderer.render(
222:      <React.StrictMode>
223:        <VNextApp runtime={runtime} onRequestLibrary={renderLibrary} />
224:      </React.StrictMode>
