731:
732:  const commitInspector = (field: keyof InspectorDraft) => {
733:    if (!selectedObject) return;
734:    if (!finishTextEditBeforeCommand()) return;
735:    if (selectedObject.type === 'group' && (field === 'width' || field === 'height')) return;
736:    controller.cancel('superseded');
737:    const raw = inspectorDraft[field].trim();
738:    const numeric = Number(raw);
739:    if (raw.length === 0 || !Number.isFinite(numeric)) { setStatusMessage('Informe um valor numérico válido em milímetros.'); return; }
740:    let valueU: number;
741:    try { valueU = mmToU(numeric); }
742:    catch { setStatusMessage('Informe um valor numérico válido em milímetros.'); return; }
743:    const current = frameToU(selectedObject.frame);
744:    let action: ApplicationAction;
745:    if (field === 'x' || field === 'y') {
746:      action = { type: 'object.move', objectId: selectedObject.id, xU: field === 'x' ? valueU : current.xU, yU: field === 'y' ? valueU : current.yU };
747:    } else {
748:      if (valueU < 1) { setStatusMessage('Largura e altura devem ser maiores que zero.'); return; }
749:      action = { type: 'object.resize', objectId: selectedObject.id, xU: current.xU, yU: current.yU, widthU: field === 'width' ? valueU : current.widthU, heightU: field === 'height' ? valueU : current.heightU };
750:    }
751:    const result = session.execute(action);
752:    setStatusMessage(result.ok ? 'Geometria atualizada.' : 'Não foi possível atualizar a geometria.');
753:  };
754:
755:  const objectPreviewFrame = (object: EditorialObject): FrameU => {
756:    if (preview?.objectId === object.id && preview.pageId === selectedPage.id) return preview.frameU;
757:    return frameToU(object.frame);
758:  };
759:
760:  const cancelOnRootKey = (event: React.KeyboardEvent<HTMLDivElement>) => {
761:    if (textEditRef.current) {
762:      if (compositionRef.current) return;
763:      if (event.key === 'Escape') {
764:        event.preventDefault();
765:        event.stopPropagation();
766:        cancelTextEdit();
