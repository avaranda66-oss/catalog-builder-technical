114:function mapSemanticRpcError(error: VNextPersistenceRpcError): PersistenceErrorCode | null {
115:  const message = rpcMessage(error);
116:  if (message.includes('VNEXT_NOT_FOUND')) return 'NOT_FOUND';
117:  if (message.includes('VNEXT_ARCHIVED')) return 'ARCHIVED';
118:  if (message.includes('VNEXT_UNSUPPORTED_VERSION')) return 'UNSUPPORTED_VERSION';
119:  if (
120:    message.includes('VNEXT_CONFLICT') ||
121:    message.includes('VNEXT_DUPLICATE_CATALOG') ||
122:    message.includes('VNEXT_MUTATION_REUSE') ||
123:    message.includes('VNEXT_MUTATION_REPLAY_STALE')
124:  ) return 'CONFLICT';
125:  if (error.code === '42501' || message.includes('VNEXT_UNAUTHORIZED') || message.includes('AUTH_')) return 'UNAUTHORIZED';
126:  if (error.code === '40001' || error.code === '23505') return 'CONFLICT';
127:  if (error.code === '22023' || error.code === '22P02' || message.includes('VNEXT_INVALID_DOCUMENT')) return 'INVALID_DOCUMENT';
128:  return null;
129:}
