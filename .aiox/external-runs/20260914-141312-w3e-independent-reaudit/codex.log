107:function isTransportLike(error: VNextPersistenceRpcError): boolean {
108:  const code = error.code?.toUpperCase();
109:  if (code && TRANSPORT_ERROR_CODES.has(code)) return true;
110:  const message = rpcMessage(error).toLowerCase();
111:  return /failed to fetch|network|timeout|timed out|connection|econn|abort/.test(message);
