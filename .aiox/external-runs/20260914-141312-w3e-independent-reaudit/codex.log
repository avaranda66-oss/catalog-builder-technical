529:    if (!result.ok) { setStatusMessage('Não foi possível adicionar a página.'); return; }
530:    const createdPageId = result.metadata.createdIds[0];
531:    if (createdPageId) setActivePage(createdPageId);
532:    setStatusMessage('Página adicionada.');
533:  };
534:
535:  const insertPageTemplate = () => {
536:    cancelTextEdit('');
537:    controller.cancel('superseded');
538:    const result = session.execute({
539:      type: 'page.template.insert',
540:      templateId: W2E_PAGE_TEMPLATE_ID,
541:      afterPageId: selectedPage.id,
542:    });
543:    if (!result.ok) { setStatusMessage('Não foi possível inserir o modelo.'); return; }
544:    const createdPageId = result.metadata.createdIds[0];
545:    if (createdPageId) setActivePage(createdPageId);
546:    setStatusMessage('Modelo inserido como página independente.');
547:  };
