50:export class VNextPersistenceRuntime {
51:  readonly workspace: PersistenceWorkspace;
52:  readonly saveCoordinator: SaveCoordinator;
53:  readonly reopenCoordinator: CanonicalReopenCoordinator;
54:  readonly recoveryCoordinator: RecoveryCoordinator | undefined;
55:  readonly recoveryManager: SessionRecoveryManager | undefined;
56:  readonly recoveryStartup: RecoveryStartupCoordinator | undefined;
