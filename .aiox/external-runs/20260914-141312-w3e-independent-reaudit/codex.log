261:  private async prepareAndDispatchAttempt(attempt: SaveAttemptBase): Promise<ManualSaveResult> {
262:    if (!this.options.recoveryLifecycle) return this.dispatchAttempt(attempt);
263:    const [baseRemoteSnapshotDigest, attemptDigest] = await Promise.all([
264:      digestCanonicalDocument(attempt.baseRemoteSnapshot),
265:      digestCanonicalDocument(attempt.request.documentSnapshot),
266:    ]);
267:    const prepared: SaveAttempt = {
268:      ...attempt,
269:      baseRemoteSnapshotDigest,
270:      pendingRemoteMutation: {
271:        mutationId: attempt.request.mutationId,
272:        catalogId: attempt.request.catalogId,
273:        expectedRemoteRevision: attempt.request.expectedRemoteRevision,
274:        previousLastMutationId: attempt.previousLastMutationId,
275:        capturedLocalEditSequence: attempt.localSequence,
276:        attemptedDocumentSnapshot: attempt.request.documentSnapshot,
277:        attemptDigestAlgorithm: 'SHA-256',
278:        attemptDigest,
279:      },
280:    };
281:    if (!this.isCurrent(prepared)) return { ok: false, error: { code: 'STALE_RESULT' } };
282:    try {
283:      await this.options.recoveryLifecycle.beforeDispatch(prepared.pendingRemoteMutation!);
284:    } catch {
285:      if (!this.isCurrent(prepared)) return { ok: false, error: { code: 'STALE_RESULT' } };
286:      this.options.workspace.setLocalProtectionUnavailable();
287:    }
288:    if (!this.isCurrent(prepared)) return { ok: false, error: { code: 'STALE_RESULT' } };
289:    return this.dispatchAttempt(prepared);
290:  }
