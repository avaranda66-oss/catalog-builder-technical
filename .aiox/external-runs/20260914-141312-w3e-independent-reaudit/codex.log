768:      }
769:      if (event.key === 'Enter' && (event.ctrlKey || event.metaKey)) {
770:        event.preventDefault();
771:        event.stopPropagation();
772:        commitTextEdit();
773:        return;
774:      }
775:      return;
776:    }
777:    if (event.key === 'Enter' && selectedObject?.type === 'text') {
778:      const target = event.target as HTMLElement;
