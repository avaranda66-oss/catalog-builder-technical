+.vnext-library-search, .vnext-library-sort { display: flex; min-height: 42px; align-items: center; gap: 8px; border: 1px solid #cbd5e1; border-radius: 7px; background: #fff; color: #67768a; padding: 0 11px; }
+.vnext-library-search { width: min(320px, 36vw); }
